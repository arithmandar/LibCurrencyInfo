package-as: LibCurrencyInfo

manual-changelog:
    filename: Docs/Revisions.txt
    markup-type: plain

enable-nolib-creation: yes

# configs for WowInterface
wowi-archive-previous: yes
wowi-create-changelog: no

externals:
   LibStub:
        url: https://repos.curseforge.com/wow/libstub/trunk
        tag: latest

ignore:
    - .util
    - .data
    - .github
